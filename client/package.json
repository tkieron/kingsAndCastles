{
  "name": "kings-and-castles-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/make-icons.mjs && vite",
    "build": "node scripts/make-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build:offline": "node scripts/make-icons.mjs && tsc --noEmit && vite build --mode offline && node scripts/one-file.mjs"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
