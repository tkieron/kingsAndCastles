<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>pl.kingscastles</groupId>
    <artifactId>kings-and-castles</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>browser</artifactId>
  <name>Kings &amp; Castles – engine for the browser</name>
  <description>The rules engine compiled to JavaScript (TeaVM) for the offline version of the game.</description>
  <properties><teavm.version>0.16.0</teavm.version></properties>
  <dependencies>
    <dependency><groupId>pl.kingscastles</groupId><artifactId>engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso</artifactId><version>${teavm.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions><execution><goals><goal>compile</goal></goals>
          <configuration>
            <mainClass>pl.kingscastles.browser.Engine</mainClass>
            <targetDirectory>${project.build.directory}/js</targetDirectory>
            <targetFileName>kc-engine.js</targetFileName>
            <minifying>true</minifying>
            <jsModuleType>ES2015</jsModuleType>
            <optimizationLevel>ADVANCED</optimizationLevel>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
